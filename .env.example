# ===== Sanad AI — variables d'environnement =====
# Copier ce fichier en `.env` et renseigner la clé :  cp .env.example .env

# Obtenir une clé : https://openrouter.ai/keys (plan gratuit disponible)
OPENROUTER_API_KEY=sk-or-v1-votre_cle_ici

# ===== Options (valeurs par défaut déjà utilisées si absentes) =====
# OPENROUTER_MODEL=poolside/laguna-s-2.1:free
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# LLM_TEMPERATURE=0.1
# LLM_MAX_TOKENS=4096

# ===== RAG =====
# CHROMA_PERSIST_DIR=chroma_db
# CHROMA_COLLECTION=immobilier_mre
# Modèle rapide CPU par défaut. Pour plus de précision : EMBEDDING_MODEL=BAAI/bge-m3
# (puis purger chroma_db/ et ré-ingérer, dimensions différentes).
# EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
# EMBEDDING_BATCH_SIZE=64
# SIMILARITY_THRESHOLD=0.60
# TOP_K=6